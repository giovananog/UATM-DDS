MAKEFILE = GNUmakefile

ifeq ($(findstring k,$(MAKEFLAGS)),k)
  KEEP_GOING = -
endif

include $(ACE_ROOT)/include/makeinclude/macros.GNU

all: uatm

depend: uatm-depend

REMAINING_TARGETS := $(filter-out all depend,$(TARGETS_NESTED:.nested=)) $(CUSTOM_TARGETS)
.PHONY: $(REMAINING_TARGETS)

$(REMAINING_TARGETS):
	$(KEEP_GOING)@cd model && $(MAKE) -f GNUmakefile.uatm $(@)

.PHONY: uatm
uatm:
	$(KEEP_GOING)@cd model && $(MAKE) -f GNUmakefile.uatm all

.PHONY: uatm-depend
uatm-depend:
	$(KEEP_GOING)@cd model && $(MAKE) -f GNUmakefile.uatm depend

project_name_list:
	@echo uatm
